# Copy to .env.local for local development. Replace every placeholder.
# Never commit .env.local or put server secrets in NEXT_PUBLIC_* variables.

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cleardrain?schema=public"

# NextAuth session secret and canonical site origin
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Google AI Studio key (complaint analysis and chatbot)
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# SMTP mail delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-user"
SMTP_PASS="replace-with-smtp-app-password"
EMAIL_FROM="ClearDrain <no-reply@example.com>"

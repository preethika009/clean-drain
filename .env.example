# Clear Drain — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/cleardrain"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-chars-long"

# ─── Gemini AI API ────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"

# ─── Email (Nodemailer via Gmail SMTP) ────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="Clear Drain <noreply@cleardrain.gov.in>"

# ─── File Uploads (local for dev / S3 for prod) ───────────────────────────────
UPLOAD_DIR="./public/uploads"
# For production S3:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"
# AWS_BUCKET_NAME="cleardrain-uploads"

# ─── App Config ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
APP_NAME="Clear Drain"
SLA_DAYS=7
